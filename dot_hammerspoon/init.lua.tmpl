hs.window.animationDuration = 0

local pushWindow = function(win, x, y, w, h)
  local f = win:frame()
  local screen = win:screen()
  local max = screen:frame()

  f.x = max.x + (max.w * x)
  f.y = max.y + (max.h * y)
  f.w = max.w * w
  f.h = max.h * h
  win:setFrame(f)

  -- Hack: https://github.com/Hammerspoon/hammerspoon/issues/3224#issuecomment-1294359070
  local axApp = hs.axuielement.applicationElement(win:application())
  local wasEnhanced = axApp.AXEnhancedUserInterface
  if wasEnhanced then
    axApp.AXEnhancedUserInterface = false
  end
  win:setFrame(f) -- or win:moveToScreen(someScreen), etc.
  if wasEnhanced then
    axApp.AXEnhancedUserInterface = true
  end
end

local push = function(x, y, w, h)
  return function()
    local win = hs.window.focusedWindow()
    pushWindow(win, x, y, w, h)
  end
end

local pushAll = function(app, x, y, w, h)
  local application = hs.application.get(app)
  if not application then
    return
  end

  local windows = application:allWindows()
  for key, win in pairs(windows) do
    pushWindow(win, x,y,w,h)
  end
end

local normalLayout = function()
  if hs.screen.mainScreen():currentMode()["w"] < 2000 then
    pushAll("Code", 0, 0, 1, 1)
    pushAll("Firefox", 0, 0, 1, 1)
    pushAll("Slack", 0, 0, 1, 1)
    pushAll("cmux", 0, 0, 1, 1)
    pushAll("Obsidian", 0, 0, 1, 1)
  else
    pushAll("Code", 1/3, 0, 2/3, 1)
    pushAll("Firefox", 1/3, 0, 2/3, 1)
    pushAll("Slack", 1/3, 0, 2/3, 1)
    pushAll("cmux", 0, 0, 1/2, 1)
    pushAll("Obsidian", 2/10, 1/10, 6/10, 8/10)
  end
end

local callLayout = function()
  if hs.screen.mainScreen():currentMode()["w"] < 2000 then
    pushAll("Code", 0, 0, 8/10, 1)
    pushAll("Firefox", 0, 0, 8/10, 1)
    pushAll("Slack", 0, 0, 8/10, 1)
    pushAll("cmux", 0, 0, 8/10, 1)
    pushAll("Obsidian", 2/10, 2/10, 6/10, 6/10)
    pushAll("Google Meet", 8/10, 0, 2/10, 1)
  else
    pushAll("Code", 2/10, 0, 7/10, 1)
    pushAll("Firefox", 2/10, 0, 7/10, 1)
    pushAll("Slack", 2/10, 0, 7/10, 1)
    pushAll("cmux", 0, 0, 4/10, 1)
    pushAll("Obsidian", 3/10, 2/10, 4/10, 6/10)
    pushAll("Google Meet", 9/10, 0, 1/10, 1/2)
  end
end

hs.hotkey.bind({"alt", "ctrl"}, "return", push(0, 0, 1, 1))
hs.hotkey.bind({"alt", "ctrl"}, "left", push(0, 0, 1/2, 1))
hs.hotkey.bind({"alt", "ctrl"}, "right", push(1/2, 0, 1/2, 1))
hs.hotkey.bind({"alt", "ctrl"}, "up", push(0, 0, 1, 1/2))
hs.hotkey.bind({"alt", "ctrl"}, "down", push(0, 1/2, 1, 1/2))

hs.hotkey.bind({"alt", "ctrl"}, "t", push(1/3, 0, 2/3, 1))
hs.hotkey.bind({"alt", "ctrl"}, "e", push(0, 0, 2/3, 1))

hs.hotkey.bind({"alt", "ctrl"}, "d", push(0, 0, 1/3, 1))
hs.hotkey.bind({"alt", "ctrl"}, "f", push(1/3, 0, 1/3, 1))
hs.hotkey.bind({"alt", "ctrl"}, "g", push(2/3, 0, 1/3, 1))

hs.hotkey.bind({"alt", "ctrl"}, "m", normalLayout)
hs.hotkey.bind({"alt", "ctrl"}, "n", callLayout)

hs.hotkey.bind({"cmd"}, "e", function()
  if hs.application.frontmostApplication():title() == "Obsidian" then
    hs.application.frontmostApplication():hide()
  else
    hs.application.launchOrFocus("Obsidian")
  end
end)
hs.hotkey.bind({"cmd"}, "1", function()
  hs.application.launchOrFocus("Visual Studio Code")
end)
hs.hotkey.bind({"cmd"}, "2", function()
  hs.application.launchOrFocus("cmux")
end)
hs.hotkey.bind({"cmd"}, "3", function()
  hs.application.launchOrFocus("Firefox")
end)

local slackBundleID = "com.tinyspeck.slackmacgap"
local discordBundleID = "com.hnc.Discord"
local function isInstalled(bundleID)
  local path = hs.application.pathForBundleID(bundleID)
  return path ~= nil and path ~= ""
end
hs.hotkey.bind({"cmd"}, "4", function()
  local slackInstalled = isInstalled(slackBundleID)
  local discordInstalled = isInstalled(discordBundleID)

  if slackInstalled and discordInstalled then
    if hs.application.frontmostApplication():title() == "Slack" then
      hs.application.launchOrFocus("Discord")
    else
      hs.application.launchOrFocus("Slack")
    end
  elseif discordInstalled then
    hs.application.launchOrFocus("Discord")
  elseif slackInstalled then
    hs.application.launchOrFocus("Slack")
  else
    hs.alert.show("Neither Slack nor Discord is installed")
  end
end)

-- Prevent macOS from sleeping (like caffeinate -di)
-- local keepAwake = hs.caffeinate.new("SystemAwake", true)

-- Enable when docked or always on AC power
hs.battery.watcher.new(function()
    if hs.battery.isCharging() then
        hs.caffeinate.set("displayIdle", true, true)
        hs.caffeinate.set("systemIdle", true, true)
    else
        hs.caffeinate.set("displayIdle", false, true)
        hs.caffeinate.set("systemIdle", false, true)
    end
end):start()

{{- if hasKey . "monitor_input" }}
-- Hammerspoon: switch the monitor to this Mac when the keyboard arrives
-- through the USB switch, or when this Mac wakes up with it attached.
-- Only rendered when `monitor_input` is set in the chezmoi config [data].

local MY_INPUT = {{ .monitor_input }}   -- this Mac's monitor input (check with: m1ddc get input)

local M1DDC            = "/opt/homebrew/bin/m1ddc"
local KEYBOARD_VENDOR  = 0x3434   -- Keychron
local KEYBOARD_PRODUCT = 0xd030   -- Keychron Link receiver

local function setInput(code)
  hs.task.new(M1DDC, function(rc, _, err)
    if rc ~= 0 then print("m1ddc set input failed: " .. tostring(err)) end
  end, { "set", "input", tostring(code) }):start()
end

local function isKeyboard(dev)
  return dev.vendorID == KEYBOARD_VENDOR and dev.productID == KEYBOARD_PRODUCT
end

local function keyboardAttached()
  for _, dev in ipairs(hs.usb.attachedDevices() or {}) do
    if isKeyboard(dev) then return true end
  end
  return false
end

-- Globals (not locals) so they aren't garbage-collected.
usbWatcher = hs.usb.watcher.new(function(dev)
  if isKeyboard(dev) and dev.eventType == "added" then
    hs.timer.doAfter(1, function() setInput(MY_INPUT) end)
  end
end)
usbWatcher:start()

wakeWatcher = hs.caffeinate.watcher.new(function(event)
  if (event == hs.caffeinate.watcher.systemDidWake
      or event == hs.caffeinate.watcher.screensDidWake)
     and keyboardAttached() then
    hs.timer.doAfter(2, function() setInput(MY_INPUT) end)
  end
end)
wakeWatcher:start()

hs.alert.show("Monitor auto-switch loaded (input " .. MY_INPUT .. ")")
{{- end }}
