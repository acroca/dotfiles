hs.window.animationDuration = 0

-- ---------------------------------------------------------------------------
-- Helpers
-- ---------------------------------------------------------------------------

-- Positions ("rects") are {x, y, w, h} as fractions of the window's screen.
local function pushWindow(win, rect)
  local x, y, w, h = table.unpack(rect)
  local screen = win:screen():frame()
  local f = win:frame()
  f.x = screen.x + screen.w * x
  f.y = screen.y + screen.h * y
  f.w = screen.w * w
  f.h = screen.h * h

  -- Workaround: temporarily turn off AXEnhancedUserInterface while resizing.
  -- https://github.com/Hammerspoon/hammerspoon/issues/3224#issuecomment-1294359070
  local axApp = hs.axuielement.applicationElement(win:application())
  local wasEnhanced = axApp.AXEnhancedUserInterface
  if wasEnhanced then axApp.AXEnhancedUserInterface = false end
  win:setFrame(f)
  if wasEnhanced then axApp.AXEnhancedUserInterface = true end
end

-- Returns a hotkey handler that moves the focused window to `rect`.
local function pushFocused(rect)
  return function()
    local win = hs.window.focusedWindow()
    if win then pushWindow(win, rect) end
  end
end

-- Moves every window of `appName` (if it's running) to `rect`.
local function pushAll(appName, rect)
  local app = hs.application.get(appName)
  if not app then return end
  for _, win in ipairs(app:allWindows()) do pushWindow(win, rect) end
end

local function frontmostIs(appName)
  return hs.application.frontmostApplication():title() == appName
end

-- Returns a hotkey handler that launches or focuses `appName`.
local function focusApp(appName)
  return function() hs.application.launchOrFocus(appName) end
end

-- Returns a hotkey handler that focuses `appName`, or hides it if it's already in front.
local function toggleApp(appName)
  return function()
    if frontmostIs(appName) then
      hs.application.frontmostApplication():hide()
    else
      hs.application.launchOrFocus(appName)
    end
  end
end

local function isInstalled(bundleID)
  local path = hs.application.pathForBundleID(bundleID)
  return path ~= nil and path ~= ""
end

-- ---------------------------------------------------------------------------
-- Window management: alt+ctrl+key moves the focused window
-- ---------------------------------------------------------------------------

local windowPositions = {
  ["return"] = {0,   0,   1,   1  }, -- full screen
  left       = {0,   0,   1/2, 1  }, -- left half
  right      = {1/2, 0,   1/2, 1  }, -- right half
  up         = {0,   0,   1,   1/2}, -- top half
  down       = {0,   1/2, 1,   1/2}, -- bottom half
  e          = {0,   0,   2/3, 1  }, -- left two-thirds
  t          = {1/3, 0,   2/3, 1  }, -- right two-thirds
  d          = {0,   0,   1/3, 1  }, -- left third
  f          = {1/3, 0,   1/3, 1  }, -- middle third
  g          = {2/3, 0,   1/3, 1  }, -- right third
}

for key, rect in pairs(windowPositions) do
  hs.hotkey.bind({"alt", "ctrl"}, key, pushFocused(rect))
end

-- ---------------------------------------------------------------------------
-- Layouts: arrange all app windows at once
--   alt+ctrl+m = normal, alt+ctrl+n = on a call
-- "small" applies when the main screen is under 2000px wide.
-- ---------------------------------------------------------------------------

local layouts = {
  normal = {
    small = {
      Code     = {0, 0, 1, 1},
      Firefox  = {0, 0, 1, 1},
      Slack    = {0, 0, 1, 1},
      cmux     = {0, 0, 1, 1},
      Obsidian = {0, 0, 1, 1},
    },
    large = {
      Code     = {1/3,  0,    2/3,  1   },
      Firefox  = {1/3,  0,    2/3,  1   },
      Slack    = {1/3,  0,    2/3,  1   },
      cmux     = {0,    0,    1/2,  1   },
      Obsidian = {2/10, 1/10, 6/10, 8/10},
    },
  },
  call = {
    small = {
      Code            = {0,    0,    8/10, 1   },
      Firefox         = {0,    0,    8/10, 1   },
      Slack           = {0,    0,    8/10, 1   },
      cmux            = {0,    0,    8/10, 1   },
      Obsidian        = {2/10, 2/10, 6/10, 6/10},
      ["Google Meet"] = {8/10, 0,    2/10, 1   },
    },
    large = {
      Code            = {2/10, 0,    7/10, 1   },
      Firefox         = {2/10, 0,    7/10, 1   },
      Slack           = {2/10, 0,    7/10, 1   },
      cmux            = {0,    0,    4/10, 1   },
      Obsidian        = {3/10, 2/10, 4/10, 6/10},
      ["Google Meet"] = {9/10, 0,    1/10, 1/2 },
    },
  },
}

local function applyLayout(layout)
  local small = hs.screen.mainScreen():currentMode().w < 2000
  for appName, rect in pairs(small and layout.small or layout.large) do
    pushAll(appName, rect)
  end
end

hs.hotkey.bind({"alt", "ctrl"}, "m", function() applyLayout(layouts.normal) end)
hs.hotkey.bind({"alt", "ctrl"}, "n", function() applyLayout(layouts.call) end)

-- ---------------------------------------------------------------------------
-- App shortcuts (cmd+key)
-- ---------------------------------------------------------------------------

-- Focuses Slack or Discord, whichever is installed; with both, flips between them.
local function slackOrDiscord()
  local slack = isInstalled("com.tinyspeck.slackmacgap")
  local discord = isInstalled("com.hnc.Discord")
  if slack and discord then
    hs.application.launchOrFocus(frontmostIs("Slack") and "Discord" or "Slack")
  elseif slack or discord then
    hs.application.launchOrFocus(slack and "Slack" or "Discord")
  else
    hs.alert.show("Neither Slack nor Discord is installed")
  end
end

hs.hotkey.bind({"cmd"}, "1", focusApp("Visual Studio Code"))
hs.hotkey.bind({"cmd"}, "2", focusApp("cmux"))
hs.hotkey.bind({"cmd"}, "3", focusApp("Firefox"))
hs.hotkey.bind({"cmd"}, "4", slackOrDiscord)
hs.hotkey.bind({"cmd"}, "5", toggleApp("Obsidian"))
hs.hotkey.bind({"cmd"}, "e", focusApp("Claude"))

-- ---------------------------------------------------------------------------
-- Power: keep the Mac and display awake while plugged in.
-- On the lock screen the display is allowed to sleep; the Mac stays awake.
-- ---------------------------------------------------------------------------

local screenLocked = false

local function updateKeepAwake()
  -- Anything but battery counts as plugged in, so Macs without a battery
  -- (the Mac mini) always stay awake.
  local pluggedIn = hs.battery.powerSource() ~= "Battery Power"
  hs.caffeinate.set("displayIdle", pluggedIn and not screenLocked, true)
  hs.caffeinate.set("systemIdle", pluggedIn, true)
end

-- Globals (not locals) so they aren't garbage-collected.
batteryWatcher = hs.battery.watcher.new(updateKeepAwake)
batteryWatcher:start()

lockWatcher = hs.caffeinate.watcher.new(function(event)
  if event == hs.caffeinate.watcher.screensDidLock then
    screenLocked = true
  elseif event == hs.caffeinate.watcher.screensDidUnlock then
    screenLocked = false
  else
    return
  end
  updateKeepAwake()
end)
lockWatcher:start()

updateKeepAwake() -- apply now too, not just on the next power change

{{- if hasKey . "monitor_input" }}

-- ---------------------------------------------------------------------------
-- Monitor switching: switch the monitor to this Mac when the keyboard arrives
-- through the USB switch, or when this Mac wakes up with it attached.
-- Only rendered when `monitor_input` is set in the chezmoi config [data].
-- ---------------------------------------------------------------------------

local MY_INPUT = {{ .monitor_input }}   -- this Mac's monitor input (check with: m1ddc get input)

local M1DDC            = "/opt/homebrew/bin/m1ddc"
local KEYBOARD_VENDOR  = 0x3434   -- Keychron
local KEYBOARD_PRODUCT = 0xd030   -- Keychron Link receiver

local function setInput(code)
  hs.task.new(M1DDC, function(rc, _, err)
    if rc ~= 0 then print("m1ddc set input failed: " .. tostring(err)) end
  end, { "set", "input", tostring(code) }):start()
end

local function isKeyboard(dev)
  return dev.vendorID == KEYBOARD_VENDOR and dev.productID == KEYBOARD_PRODUCT
end

local function keyboardAttached()
  for _, dev in ipairs(hs.usb.attachedDevices() or {}) do
    if isKeyboard(dev) then return true end
  end
  return false
end

-- Globals (not locals) so they aren't garbage-collected.
usbWatcher = hs.usb.watcher.new(function(dev)
  if isKeyboard(dev) and dev.eventType == "added" then
    hs.timer.doAfter(1, function() setInput(MY_INPUT) end)
  end
end)
usbWatcher:start()

wakeWatcher = hs.caffeinate.watcher.new(function(event)
  if (event == hs.caffeinate.watcher.systemDidWake
      or event == hs.caffeinate.watcher.screensDidWake)
     and keyboardAttached() then
    hs.timer.doAfter(2, function() setInput(MY_INPUT) end)
  end
end)
wakeWatcher:start()

hs.alert.show("Monitor auto-switch loaded (input " .. MY_INPUT .. ")")
{{- end }}
